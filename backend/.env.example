# Copy to .env and fill in. Never commit .env.

# Postgres connection. Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/realapp?schema=public"

# Signs login tokens. At least 32 random characters, different per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required when NODE_ENV=production, the server won't start without it.
# Proxies in front of the app (1 on most hosts, 0 for none), so rate limits see the real client IP
TRUST_PROXY_HOPS=0

# Comma-separated website addresses allowed to call the API from a browser.
# The admin website (HBR_Website) must be listed. The mobile app doesn't need this.
ALLOWED_ORIGINS=http://localhost:4173

# Optional
# PORT=3001
# NODE_ENV=production
# Failed login attempts per IP per 15 minutes
# AUTH_RATE_LIMIT=10
# Requests per IP per minute
# API_RATE_LIMIT=300
