# Copy to .env and fill in. Never commit .env.

# Postgres connection. Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/realapp?schema=public"

# Signs login tokens. At least 32 random characters, different per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
# PORT=3001
# NODE_ENV=production
# Proxies in front of the app (1 on most hosts), so rate limits see the real client IP
# TRUST_PROXY_HOPS=1
# Comma-separated browser origins allowed to call the API. The mobile app doesn't need this.
# ALLOWED_ORIGINS=https://admin.example.com
# Failed login attempts per IP per 15 minutes
# AUTH_RATE_LIMIT=10
# Requests per IP per minute
# API_RATE_LIMIT=300
